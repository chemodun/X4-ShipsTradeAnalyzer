<?xml version="1.0" encoding="utf-8"?>
<mdscript name="Ships_Trade_Analyzer"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:noNamespaceSchemaLocation="../../libraries/md.xsd">
  <!--
    Ships Trade Analyzer - Options, sector graph and interaction-menu integration.

    Config keys under player.entity.$ShipsTradeAnalyzerConfig:
      $rescanIntervalMinutes  - int 0-10: how stale a scan may be before an open
                                re-reads the log; 0 = always
      $timePeriodForInternalTradesSeparation
                              - int 5-30 minutes: two same-way trades of one ware
                                further apart than this are separate trips home
      $debugLevel             - 'none' | 'debug' | 'trace'

    No collection timer and no stored trade data: the trade log is the engine's own,
    read on demand by ui/sta_data.lua.
  -->

  <cues>

    <cue name="Init" instantiate="false" version="1">
      <actions>
        <set_value name="$debugLevelIndexes" exact="['none', 'debug', 'trace']" />
      </actions>
      <cues>

        <library name="STA_Defaults" purpose="include_actions">
          <actions>
            <set_value name="$cfg" exact="table[
              $rescanIntervalMinutes = 1,
              $timePeriodForInternalTradesSeparation = 10,
              $debugLevel            = 'none',
            ]" />
          </actions>
        </library>

        <!-- Sets $debugChance and $traceChance; the caller removes both when done. -->
        <library name="STA_ReadDebugChances" purpose="include_actions">
          <actions>
            <set_value name="$staDebugLevel" exact="if @player.entity.$ShipsTradeAnalyzerConfig.$debugLevel != null
              then player.entity.$ShipsTradeAnalyzerConfig.$debugLevel else 'none'" />
            <set_value name="$debugChance" exact="if @$staDebugLevel == null or @$staDebugLevel == 'none' then 0 else 100" />
            <set_value name="$traceChance" exact="if @$staDebugLevel == 'trace' then 100 else 0" />
            <remove_value name="$staDebugLevel" />
          </actions>
        </library>

        <!-- =============== Sector gate graph ===============
             Lua has no gate-hop call, so the galaxy's directed sector adjacency is
             published to player.entity.$ShipsTradeAnalyzerGraph and ui/sta_graph.lua
             runs the BFS. No knownness filter: a trade's endpoints are in the log
             whether or not the player ever flew there. Adjacency only, never the
             distance matrix - ~400 edges against ~23000 pairs. -->
        <library name="STA_BuildSectorGraph" purpose="include_actions">
          <actions>
            <!-- Wall clock: the build runs inside one frame, so game time cannot measure it. -->
            <set_value name="$staStarted" exact="player.systemtime.{'%H:%M:%S'}" />
            <find_sector name="$staSectors" multiple="true" space="player.galaxy" />
            <create_list name="$staEdges" />
            <do_for_each name="$staSector" in="$staSectors">
              <find_sector_in_range distances="$staHops" object="$staSector" maxdistance="1" multiple="true" />
              <!-- .keys is not a list by itself; .list is the enumerable form -->
              <do_for_each name="$staOther" in="$staHops.keys.list">
                <!-- The source sector is in its own result at distance 0 -->
                <do_if value="$staOther != $staSector">
                  <!-- One direction only: a lone superhighway link is not symmetric -->
                  <append_to_list name="$staEdges"
                    exact="table[$from = $staSector.macro, $to = $staOther.macro]" />
                </do_if>
              </do_for_each>
              <remove_value name="$staHops" />
            </do_for_each>
            <set_value name="player.entity.$ShipsTradeAnalyzerGraph" exact="$staEdges" />
            <debug_text text="'[STA]: sector graph built - %s sectors, %s directed edges, started %s, finished %s.'.[
              $staSectors.count, $staEdges.count, $staStarted, player.systemtime.{'%H:%M:%S'}]"
              chance="$debugChance" filter="scripts" />
            <remove_value name="$staStarted" />
            <remove_value name="$staSectors" />
            <remove_value name="$staEdges" />
            <raise_lua_event name="'ShipsTradeAnalyzer.SectorGraphReady'" />
          </actions>
        </library>

        <!-- The only builder: ui/sta_graph.lua asks on every game load, since a
             saved graph predates whatever gate that load unlocks. -->
        <cue name="STA_Graph_Request" instantiate="true" version="2">
          <conditions>
            <event_ui_triggered screen="'ShipsTradeAnalyzer'" control="'requestSectorGraph'" />
          </conditions>
          <actions>
            <include_actions ref="STA_ReadDebugChances" />
            <include_actions ref="STA_BuildSectorGraph" />
            <remove_value name="$debugChance" />
            <remove_value name="$traceChance" />
          </actions>
        </cue>

        <!-- =============== Options menu registration =============== -->
        <cue name="STA_Register_Menu" instantiate="true" version="5">
          <conditions>
            <event_cue_signalled cue="md.Simple_Menu_API.Reloaded" />
          </conditions>
          <actions>
            <include_actions ref="STA_Defaults" />
            <do_if value="@player.entity.$ShipsTradeAnalyzerConfig == null">
              <set_value name="player.entity.$ShipsTradeAnalyzerConfig" exact="$cfg" />
            </do_if>
            <do_else>
              <!-- Back-fill any key missing from an older save -->
              <do_for_each name="$k" in="$cfg">
                <do_if value="@player.entity.$ShipsTradeAnalyzerConfig.{$k} == null">
                  <set_value name="player.entity.$ShipsTradeAnalyzerConfig.{$k}" exact="$cfg.{$k}" />
                </do_if>
              </do_for_each>
            </do_else>
            <remove_value name="$cfg" />

            <signal_cue_instantly cue="md.Simple_Menu_API.Register_Options_Menu"
              param="table[
                $id      = 'ships_trade_analyzer_options_menu',
                $columns = 12,
                $title   = {1972092439, 1},
                $onOpen  = STA_Options_Menu,
              ]" />
          </actions>
        </cue>

        <!-- =============== Options menu open callback =============== -->
        <cue name="STA_Options_Menu" instantiate="true" version="5">
          <conditions>
            <event_cue_signalled />
          </conditions>
          <actions>
            <do_if value="@player.entity.$ShipsTradeAnalyzerConfig != null">
              <set_value name="$cfg" exact="player.entity.$ShipsTradeAnalyzerConfig" />

              <run_actions ref="md.Options_Helper.Add_Title_Row">
                <param name="title" value="{1972092439, 1}" />
              </run_actions>

              <include_actions ref="md.Options_Helper.Add_Empty_Row" />

              <!-- 0 re-reads the trade log on every menu open -->
              <run_actions ref="md.Options_Helper.Add_Slider">
                <param name="id" value="'rescanIntervalMinutes'" />
                <param name="min" value="0" />
                <param name="max" value="10" />
                <param name="step" value="1" />
                <param name="text" value="{1972092439, 90101}" />
                <param name="suffix" value="' %s'.[{1001, 103}]" />
                <param name="colSpan" value="6" />
                <param name="textColSpan" value="6" />
                <param name="data" value="$cfg" />
                <param name="handle" value="STA_HandleSlider" />
              </run_actions>

              <!-- Only reached with Inject Internal on; the scan applies it. -->
              <run_actions ref="md.Options_Helper.Add_Slider">
                <param name="id" value="'timePeriodForInternalTradesSeparation'" />
                <param name="min" value="5" />
                <param name="max" value="30" />
                <param name="step" value="1" />
                <param name="text" value="{1972092439, 90102}" />
                <param name="suffix" value="' %s'.[{1001, 103}]" />
                <param name="colSpan" value="6" />
                <param name="textColSpan" value="6" />
                <param name="data" value="$cfg" />
                <param name="handle" value="STA_HandleSlider" />
              </run_actions>

              <!-- Section: Debug -->
              <include_actions ref="md.Options_Helper.Add_Empty_Row" />
              <run_actions ref="md.Options_Helper.Add_Title_Row">
                <param name="title" value="{1972092439, 90900}" />
              </run_actions>

              <set_value name="$debugLevelOptions" exact="[
                table[$text = {1972092439, 90911}, $value = 'none'],
                table[$text = {1972092439, 90912}, $value = 'debug'],
                table[$text = {1972092439, 90913}, $value = 'trace']
              ]" />
              <set_value name="$debugLevelCurrentIndex"
                exact="$debugLevelIndexes.indexof.{@$cfg.$debugLevel}" />
              <do_if value="$debugLevelCurrentIndex == 0">
                <set_value name="$debugLevelCurrentIndex" exact="1" />
              </do_if>

              <run_actions ref="md.Options_Helper.Add_Dropdown">
                <param name="id" value="'debugLevel'" />
                <param name="options" value="$debugLevelOptions" />
                <param name="currentIndex" value="$debugLevelCurrentIndex" />
                <param name="col" value="1" />
                <param name="textColSpan" value="6" />
                <param name="text" value="{1972092439, 90910}" />
                <param name="dropdownColSpan" value="6" />
                <param name="handle" value="STA_HandleDropdown" />
              </run_actions>
              <remove_value name="$debugLevelOptions" />
              <remove_value name="$debugLevelCurrentIndex" />

              <remove_value name="$cfg" />
            </do_if>
          </actions>
        </cue>

        <!-- =============== Options handlers =============== -->
        <cue name="STA_HandleSlider" instantiate="true" version="1">
          <conditions>
            <event_cue_signalled />
          </conditions>
          <actions>
            <set_value name="$resultTable" exact="player.entity.$ShipsTradeAnalyzerConfig" />
            <include_actions ref="md.Options_Helper.Process_Slider_Changed" />
            <remove_value name="$resultTable" />
          </actions>
        </cue>

        <cue name="STA_HandleDropdown" instantiate="true" version="1">
          <conditions>
            <event_cue_signalled />
          </conditions>
          <actions>
            <set_value name="$resultTable" exact="player.entity.$ShipsTradeAnalyzerConfig" />
            <include_actions ref="md.Options_Helper.Process_Dropdown_Changed" />
            <remove_value name="$resultTable" />
            <do_if value="event.param.$echo.$valueId == '$debugLevel'">
              <raise_lua_event name="'ShipsTradeAnalyzer.DebugLevelChanged'"
                param="player.entity.$ShipsTradeAnalyzerConfig.$debugLevel" />
            </do_if>
          </actions>
        </cue>

        <!-- =============== Interaction menu entry ===============
             Re-registered on every interact menu open, per Interact_Menu_API. A
             station opens filtered to its subordinates, a ship preselected. -->
        <cue name="STA_Add_Interact_Action" instantiate="true" version="2">
          <conditions>
            <event_cue_signalled cue="md.Interact_Menu_API.Get_Actions" />
          </conditions>
          <actions>
            <include_actions ref="STA_ReadDebugChances" />
            <set_value name="$target" exact="event.param.$object" />
            <do_if value="$target != null and $target.trueowner == faction.player
              and $target.isclass.{class.ship} and not $target.isclass.spacesuit
               and not $target.isclass.ship_xs and not $target.islasertower
              and not $target.isunit and not $target.isdeployable and not $target.iswreck">
              <debug_text text="'[STA]: STA_Add_Interact_Action adding action for %s.'.[$target.debugname]"
                chance="$traceChance" filter="scripts" />
              <signal_cue_instantly cue="md.Interact_Menu_API.Add_Action"
                param="table[
                  $id       = 'ships_trade_analyzer_open',
                  $text     = {1972092439, 1014},
                  $section  = 'main',
                  $callback = STA_Interact_Callback,
                ]" />
            </do_if>
            <remove_value name="$target" />
            <remove_value name="$debugChance" />
            <remove_value name="$traceChance" />
          </actions>
        </cue>

        <cue name="STA_Interact_Callback" instantiate="true" version="1">
          <conditions>
            <event_cue_signalled />
          </conditions>
          <actions>
            <include_actions ref="STA_ReadDebugChances" />
            <debug_text text="'[STA]: STA_Interact_Callback opening menu for %s.'.[event.param.$object.debugname]"
              chance="$debugChance" filter="scripts" />
            <raise_lua_event name="'ShipsTradeAnalyzer.OpenMenu'" param="event.param.$object" />
            <remove_value name="$debugChance" />
            <remove_value name="$traceChance" />
          </actions>
        </cue>

      </cues>
    </cue>

  </cues>
</mdscript>